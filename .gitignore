# ====================================
# Backend (Java/Spring Boot/Maven)
# ====================================

# Compiled class files
*.class

# Log files
*.log

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven
Backend/target/
!Backend/.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Maven wrapper
.mvn/

# IDE - IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# IDE - Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# IDE - NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# IDE - VS Code
.vscode/

# Application properties with secrets
Backend/src/main/resources/application-local.properties
Backend/src/main/resources/application-prod.properties

# ====================================
# Frontend (React/Vite/Node.js)
# ====================================

# Dependencies
Frontend/node_modules/
node_modules/

# Build output
Frontend/dist/
Frontend/build/

# Local env files
Frontend/.env
Frontend/.env.local
Frontend/.env.development.local
Frontend/.env.test.local
Frontend/.env.production.local

# Vite
Frontend/*.local

# ====================================
# General
# ====================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor directories and files
*.swp
*.swo
*~

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Lock files (optional - uncomment if you want to ignore)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Environment variables
.env
.env.*
!.env.example

# Temporary files
*.tmp
*.temp
.cache/

# Test coverage
coverage/
*.lcov

# Misc
*.pem
*.key
